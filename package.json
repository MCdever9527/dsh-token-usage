{
  "name": "dsh-token-usage",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Token usage statistics for DSH: scan every stored session log (including archived ones) and report provider-by-model token totals on a Settings page, kept live through the workspace-files watch stream.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:tests": "node build.mjs --tests",
    "test": "node build.mjs --tests && node tools/run-tests.mjs && node tools/smoke-client.mjs && node tools/smoke-host.mjs",
    "test:client": "node tools/smoke-client.mjs",
    "test:host": "node tools/smoke-host.mjs",
    "typecheck": "node tools/tsc.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ]
}
